const API="https://api.github.com";
function out(res,status,data){res.status(status).setHeader("Cache-Control","no-store");res.setHeader("Content-Type","application/json; charset=utf-8");return res.end(JSON.stringify(data));}
function cfg(){const c={owner:process.env.GITHUB_OWNER,repo:process.env.GITHUB_REPO,branch:process.env.GITHUB_BRANCH||"main",path:process.env.GITHUB_FILE_PATH||"tokens.json",token:process.env.GITHUB_TOKEN};if(!c.owner||!c.repo||!c.token)throw Error("Atur GITHUB_OWNER, GITHUB_REPO, dan GITHUB_TOKEN di Vercel.");return c;}
async function gh(url,c,opts={}){const r=await fetch(url,{...opts,headers:{Accept:"application/vnd.github+json",Authorization:"Bearer "+c.token,"X-GitHub-Api-Version":"2022-11-28","User-Agent":"Dazz-License-Manager",...(opts.headers||{})}});const t=await r.text();let d={};try{d=JSON.parse(t)}catch{}if(!r.ok){const e=Error(d.message||"GitHub API error "+r.status);e.status=r.status;throw e}return d;}
async function read(c){const p=c.path.split("/").map(encodeURIComponent).join("/");const d=await gh(`${API}/repos/${encodeURIComponent(c.owner)}/${encodeURIComponent(c.repo)}/contents/${p}?ref=${encodeURIComponent(c.branch)}`,c);const obj=JSON.parse(Buffer.from(d.content.replace(/\n/g,""),"base64").toString("utf8"));const a=Array.isArray(obj)?obj:obj.tokens;if(!Array.isArray(a)||!a.every(x=>typeof x==="string"))throw Error('Format tokens.json harus {"tokens":["TOKEN"]}.');return {tokens:[...new Set(a.map(x=>x.trim()).filter(Boolean))],sha:d.sha};}
async function write(c,tokens,sha,msg){const p=c.path.split("/").map(encodeURIComponent).join("/");return gh(`${API}/repos/${encodeURIComponent(c.owner)}/${encodeURIComponent(c.repo)}/contents/${p}`,c,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({message:msg,content:Buffer.from(JSON.stringify({tokens},null,2)+"\n").toString("base64"),sha,branch:c.branch})});}
module.exports=async(req,res)=>{try{if(req.method==="OPTIONS"){res.setHeader("Allow","GET, POST, DELETE, OPTIONS");return out(res,204,{})}const c=cfg();if(req.method==="GET"){const d=await read(c);return out(res,200,{ok:true,tokens:d.tokens,count:d.tokens.length})}if(req.method==="POST"){const token=typeof req.body?.token==="string"?req.body.token.trim():"";if(!token||/\s/.test(token)||token.length>512)return out(res,400,{ok:false,error:"Token kosong atau format tidak valid."});const d=await read(c);if(d.tokens.includes(token))return out(res,409,{ok:false,error:"Token sudah terdaftar."});d.tokens.push(token);await write(c,d.tokens,d.sha,"license: add token");return out(res,200,{ok:true,message:"Token berhasil ditambahkan.",count:d.tokens.length})}if(req.method==="DELETE"){const token=typeof req.body?.token==="string"?req.body.token.trim():"";if(!token)return out(res,400,{ok:false,error:"Token tidak boleh kosong."});const d=await read(c);if(!d.tokens.includes(token))return out(res,404,{ok:false,error:"Token tidak ditemukan."});const a=d.tokens.filter(x=>x!==token);await write(c,a,d.sha,"license: delete token");return out(res,200,{ok:true,message:"Token berhasil dihapus.",count:a.length})}return out(res,405,{ok:false,error:"Method tidak didukung."})}catch(e){console.error("[LICENSE API]",e.message);return out(res,e.status||500,{ok:false,error:e.message||"Kesalahan server."})}};
